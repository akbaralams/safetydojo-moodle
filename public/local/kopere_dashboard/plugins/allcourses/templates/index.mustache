{{!
    @template koperedashboard_allcourses/index

    Example context (json):
    {
        "q": "",
        "intro": "Courses below are open for enrolment.",
        "placeholder": "Course name, short name or ID number",
        "hascourses": true,
        "emptymessage": "No course matches your search.",
        "formurl": "https://moodle.example.com/local/kopere_dashboard/plugins/allcourses/",
        "enrolurl": "https://moodle.example.com/local/kopere_dashboard/plugins/allcourses/enrol.php",
        "sesskey": "abc123",
        "courses": [
            {
                "id": 12,
                "imageurl": "https://moodle.example.com/pluginfile.php/123/course/overviewfiles/cover.jpg",
                "fullname": "Fire safety",
                "shortname": "FS",
                "category": "Ajinomoto Module",
                "summary": "Basic fire safety training.",
                "startdate": "1 July 2026",
                "canenrol": true,
                "needspassword": false,
                "reason": "",
                "enrolkeyurl": "https://moodle.example.com/enrol/index.php?id=12",
                "courseurl": "https://moodle.example.com/course/view.php?id=12",
                "hascertificate": true,
                "certificateurl": "https://moodle.example.com/mod/customcert/view.php?id=45"
            }
        ]
    }
}}

<div class="kopere_dashboard-card">
    <p class="text-muted">{{{intro}}}</p>

    <form method="get" action="{{{formurl}}}" class="kopere_dashboard-allcourses-search">
        <label class="form-label" for="kopere_dashboard-allcourses-q">
            {{#str}}search_label, koperedashboard_allcourses{{/str}}
        </label>
        <div class="input-group">
            <input type="text"
                   id="kopere_dashboard-allcourses-q"
                   class="form-control"
                   name="q"
                   value="{{{q}}}"
                   placeholder="{{{placeholder}}}"
                   autocomplete="off">
            <button type="submit" class="btn btn-primary">{{#str}}search, core{{/str}}</button>
        </div>
    </form>
</div>

<div class="kopere_dashboard-card" style="margin-top: 16px;">
    {{#hascourses}}
        <div class="kopere_dashboard-coursegrid">
            {{#courses}}
                <div class="kopere_dashboard-coursecard">
                    <div class="kopere_dashboard-coursecard-image">
                        <img src="{{{imageurl}}}" alt="">
                    </div>
                    <div class="kopere_dashboard-coursecard-body">
                        <div class="kopere_dashboard-coursecard-head">
                            <div class="kopere_dashboard-coursecard-title">{{{fullname}}}</div>
                            {{#enrolled}}
                                <span class="kopere_dashboard-student-status">
                                    {{#str}}status_enrolled, koperedashboard_allcourses{{/str}}</span>
                            {{/enrolled}}
                        </div>
                        <div class="kopere_dashboard-coursecard-meta">
                            {{{shortname}}} · {{{category}}} · {{{startdate}}}
                        </div>
                        <div class="kopere_dashboard-coursecard-summary">{{{summary}}}</div>

                        <div class="kopere_dashboard-coursecard-actions">
                            {{#enrolled}}
                                <a class="btn btn-secondary btn-sm" href="{{{courseurl}}}">
                                    {{#str}}action_open, koperedashboard_allcourses{{/str}}</a>
                                {{#hascertificate}}
                                    <a class="btn btn-outline-danger btn-sm" href="{{{certificateurl}}}">
                                        <i class="fa fa-certificate me-1" aria-hidden="true"></i>
                                        {{#str}}action_view_certificate, koperedashboard_allcourses{{/str}}</a>
                                {{/hascertificate}}
                            {{/enrolled}}
                            {{^enrolled}}
                                {{#canenrol}}
                                    {{#needspassword}}
                                        <div>
                                            <a class="btn btn-primary btn-sm" href="{{{enrolkeyurl}}}">
                                                {{#str}}action_enrol, koperedashboard_allcourses{{/str}}</a>
                                            <div class="text-muted small mt-1">
                                                {{#str}}enrol_needspassword, koperedashboard_allcourses{{/str}}
                                            </div>
                                        </div>
                                    {{/needspassword}}
                                    {{^needspassword}}
                                        <form method="post" action="{{{enrolurl}}}">
                                            <input type="hidden" name="sesskey" value="{{{sesskey}}}">
                                            <input type="hidden" name="courseid" value="{{{id}}}">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                {{#str}}action_enrol, koperedashboard_allcourses{{/str}}
                                            </button>
                                        </form>
                                    {{/needspassword}}
                                {{/canenrol}}
                                {{^canenrol}}
                                    <span class="text-muted small">{{{reason}}}</span>
                                {{/canenrol}}
                            {{/enrolled}}
                        </div>
                    </div>
                </div>
            {{/courses}}
        </div>
    {{/hascourses}}

    {{^hascourses}}
        <div class="alert alert-info" style="margin-bottom: 0;">{{{emptymessage}}}</div>
    {{/hascourses}}
</div>
